# Copy to .env and adjust for local runs (never commit .env).
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/lab.db
# Required: use a unique, randomly generated secret of at least 32 characters.
# Keep the actual secret in your local .env file; never commit it.
SESSION_SECRET=

# Login policy is configured at startup; there is no HTTP toggle.
# LOGIN_MODE is observe or protect.
LOGIN_MODE=observe
ACCOUNT_FAILURE_LIMIT=5
IP_FAILURE_LIMIT=15
WINDOW_SECONDS=60
ACCOUNT_COOLDOWN_SECONDS=60
IP_COOLDOWN_SECONDS=60

# Vulnerable search stays off unless this is true AND the server is on loopback.
LAB_MODE=false

# Optional: Neon PostgreSQL URL for evaluation only (npm run db:check:neon).
# Never commit real credentials. Leave empty if using SQLite only.
DATABASE_URL=
