{
  "name": "cecs378-group10-security-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local SQL injection and login protection lab (Group 10)",
  "engines": {
    "node": ">=24 <25"
  },
  "volta": {
    "node": "24.21.0"
  },
  "scripts": {
